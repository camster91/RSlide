{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rslide",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-09-01",
  "observability": { "enabled": true },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [{ "name": "EVENTS", "class_name": "EventRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["EventRoom"] }],
  "vars": {
    // Delete events this many hours after they are created. Leave empty to keep forever.
    "EVENT_TTL_HOURS": "",
    // Max attendees connected at once per event. "0" = unlimited.
    "MAX_PARTICIPANTS": "0"
  }
}
